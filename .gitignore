# =========================
# Secrets / environment
# =========================
.env
.env.*
!.env.example

# =========================
# Terraform
# =========================
# Local Terraform working directories
.terraform/

# State files — may contain secrets
*.tfstate
*.tfstate.*

# Terraform variable files — may contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved Terraform plans
*.tfplan

